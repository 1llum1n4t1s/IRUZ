<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IRUZ.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="368"
        x:Class="IRUZ.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Icon="/icon/app.ico"
        Title="{Binding AppVersion}"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ExtendClientAreaTitleBarHeightHint="32"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <!--  ウィンドウ背景：アクリルブラー  -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintOpacity="0.4"
                    TintColor="{DynamicResource Color.Window}" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <!--  コンテンツ（上マージンは拡張タイトルバー 32px を避ける）  -->
        <StackPanel Margin="16,40,16,16">

            <primitives:HeaderedContentControl Header="状態">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="14"
                               Foreground="{DynamicResource Brush.FG1}"/>
                    <!-- 自動解除の予定があるときだけ、残り時間と解除予定時刻を出す -->
                    <TextBlock Text="{Binding AutoStopText}"
                               IsVisible="{Binding HasAutoStop}"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.Accent}"/>
                </StackPanel>
            </primitives:HeaderedContentControl>

            <primitives:HeaderedContentControl Header="設定">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto"
                      HorizontalAlignment="Left" ColumnSpacing="12" RowSpacing="10">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="間隔:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding IntervalOptions}"
                                  SelectedItem="{Binding SelectedIntervalSeconds}"
                                  MinWidth="96"
                                  IsEnabled="{Binding !IsRunning}"/>
                        <TextBlock Text="秒" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 自動解除はジグル中でも変更できる（変更した時点から数え直す） -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="自動解除:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding AutoStopOptions}"
                              SelectedItem="{Binding SelectedAutoStopOption}"
                              MinWidth="96"
                              ToolTip.Tip="指定した時間が経つとジグルを自動で停止し、離席と判定される状態へ戻ります"/>
                </Grid>

                <CheckBox Content="スタートアップに登録する"
                          IsChecked="{Binding IsStartupEnabled}"
                          ToolTip.Tip="Windows へのログイン時に IRUZ を自動起動します"
                          HorizontalAlignment="Left"/>
              </StackPanel>
            </primitives:HeaderedContentControl>

            <!-- 設定項目は左寄せだが、操作ボタンは行として中央に置く -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Content="{Binding ToggleButtonText}"
                        Command="{Binding ToggleCommand}"
                        MinWidth="100"/>
                <Button Content="最小化"
                        Command="{Binding MinimizeCommand}"
                        MinWidth="100"
                        ToolTip.Tip="ウィンドウをタスクトレイへ格納します（ジグルは動き続けます）"/>
                <Button Content="終了"
                        Command="{Binding ExitCommand}"
                        MinWidth="100"
                        ToolTip.Tip="IRUZ を終了します（タスクトレイからも消えます）"/>
            </StackPanel>
        </StackPanel>
    </Panel>
</Window>
